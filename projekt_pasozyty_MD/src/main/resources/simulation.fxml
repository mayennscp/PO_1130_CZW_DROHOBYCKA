<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="agh.ics.oop.presenter.SimulationPresenter">
    <top>
        <HBox alignment="CENTER" spacing="30" style="-fx-padding: 15; -fx-background-color: #eee;">
            <Label fx:id="dayLabel" text="Dzień: 0" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
            <Button fx:id="pauseButton" text="Pauza" onAction="#onPauseClick" style="-fx-font-size: 16;"/>
        </HBox>
    </top>
    <center>
        <Pane fx:id="canvasContainer" style="-fx-background-color: #1a1a1a;">
            <Canvas fx:id="canvas"/>
        </Pane>
    </center>
    <right>
        <VBox spacing="15" prefWidth="350" style="-fx-padding: 25; -fx-background-color: #2c2c2c;">
            <Label text="STATYSTYKI" style="-fx-text-fill: #3498db; -fx-font-weight: bold; -fx-font-size: 18;"/>
            <VBox spacing="8">
                <Label fx:id="animalCountLabel" text="Suma zwierząt: 0" style="-fx-text-fill: white;"/>
                <Label fx:id="normalCountLabel" text="Żywiciele: 0" style="-fx-text-fill: #2ecc71;"/>
                <Label fx:id="parasiteCountLabel" text="Pasożyty: 0" style="-fx-text-fill: #e74c3c;"/>
                <Label fx:id="plantCountLabel" text="Rośliny: 0" style="-fx-text-fill: #f1c40f;"/>
                <Label fx:id="freeFieldsLabel" text="Wolne pola: 0" style="-fx-text-fill: #ecf0f1;"/>
                <Label fx:id="avgEnergyLabel" text="Średnia energia: 0" style="-fx-text-fill: #ecf0f1;"/>
                <Label fx:id="avgLifeLabel" text="Średnie życie: 0" style="-fx-text-fill: #ecf0f1;"/>
                <Label fx:id="avgChildrenLabel" text="Średnia dzieci: 0" style="-fx-text-fill: #ecf0f1;"/>
            </VBox>
            <Label text="Dominujący genom:" style="-fx-text-fill: #3498db; -fx-font-weight: bold;"/>
            <Label fx:id="genotypeLabel" text="-" wrapText="true" style="-fx-text-fill: #00ff00; -fx-font-family: 'Monospaced'; -fx-font-size: 11;"/>
        </VBox>
    </right>
</BorderPane>